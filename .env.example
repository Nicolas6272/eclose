# Copy to .env.local and add your API keys (never commit .env.local)

# Optional: Perenual API (free tier: 100 req/day, species 1-3000 only)
# Get your key at https://perenual.com/docs/api
PERENUAL_API_KEY=sk-JxSF6a3eb6563daf018428

# Optional: Open Plantbook (free, requires registration)
# Register at https://open.plantbook.io to get credentials
# Use EITHER Api-Key OR OAuth2 (client_id + secret), not both

# Option 1: API Key (simpler, recommended for scripts)
OPENPLANTBOOK_API_KEY=your-api-key-here

# Option 2: OAuth2 credentials (for advanced use)
# OPENPLANTBOOK_CLIENT_ID=your-client-id
# OPENPLANTBOOK_SECRET=your-client-secret

# Note: PlantSolve requires no API key (static CORS-enabled JSON)
